{
    "name": "rluders/wn-jwtauth-plugin",
    "type": "winter-plugin",
    "description": "JSON Web Token Authentication plugin for Winter CMS",
    "keywords": [
        "winter",
        "cms",
        "wintercms",
        "api",
        "authentication",
        "json",
        "web token",
        "jwt"
    ],
    "homepage": "http://www.luders.com.br",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Ricardo Lüders",
            "email": "ricardo@luders.com.br",
            "homepage": "http://www.luders.com.br",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "RLuders\\JWTAuth\\": ""
        }
    },
    "require": {
        "php": ">=8.1",
        "winter/wn-user-plugin": "^2.0",
        "php-open-source-saver/jwt-auth": "^2.2"
    },
    "require-dev": {
        "mockery/mockery": "^1.6"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    }
}
